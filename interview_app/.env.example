# Mock Interview System — environment template.
# Copy to `interview_app/.env` to override defaults. The real .env is gitignored.
#
#   cp interview_app/.env.example interview_app/.env
#
# By default the live AI interviewer talks to the local genAI bridge (keyless,
# OpenAI-compatible). If the bridge isn't running, the app degrades to "offline
# reveal" mode (self-grade against the model answers) per question.

# genAI bridge base URL (OpenAI Chat Completions compatible).
INTERVIEW_LLM_BASE_URL=http://localhost:11211/api/openai/v1

# Model id served by the bridge. Options:
#   aws:anthropic.claude-opus-4-8      (default)
#   aws:anthropic.claude-sonnet-4-6
#   gcp:gemini-3.1-pro-preview
#   gcp:gemini-3.5-flash
INTERVIEW_MODEL_ID=aws:anthropic.claude-opus-4-8

# The bridge is keyless; leave as-is. (ANTHROPIC_API_KEY also works as a fallback.)
INTERVIEW_LLM_API_KEY=not-needed

# Set to 0 to force offline reveal mode even when the bridge is available.
INTERVIEW_LLM_ENABLED=1
