<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>/* set appearance before paint (no flash) */(function(){try{var t=localStorage.getItem('frontier-theme');if(['light','dim','dark','midnight'].indexOf(t)<0)t='dim';document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','dim');}})();</script>
<script>/* set reading language before paint (no flash) */(function(){try{var l=localStorage.getItem('frontier-lang');if(['en','zh'].indexOf(l)<0)l='en';document.documentElement.setAttribute('data-lang',l);document.documentElement.setAttribute('lang',l==='zh'?'zh-Hans':'en');}catch(e){document.documentElement.setAttribute('data-lang','en');}})();</script>
<title>Module 2 · Day 2 — Activation Functions</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ===========================================================================
   M1 Day 3 — dark "lab notebook" skin, modeled on visual-tutorial/index.html
   (sidebar nav + progress checklist + numbered content column), dark palette.
   Self-contained, offline. Progress persists to localStorage.
   =========================================================================== */
:root{
  /* theme-independent: accents, type, radii, shadows */
  --accent:#8091FF; --accent-d:#6B7BF0; --accent-soft:#1B2340; --on-soft:#EDF1F7;
  --q:#5B9BFF; --k:#B39BFF; --v:#FF9B5C;
  --ok:#5BC98A; --ok-ink:#8FE3AE; --ok-soft:#12271C; --ok-line:#1E7E4C;
  --warn:#E7B04A; --warn-soft:#2A2410; --warn-line:#8A6A18;
  --err:#F07A6A; --err-ink:#F8A99B; --err-soft:#2C1A17; --err-line:#9A3B2C;
  --radius:16px; --r-sm:8px; --r-md:12px; --r-full:9999px;
  --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 30px rgba(0,0,0,.35);
  --shadow-sm:0 2px 8px rgba(0,0,0,.28);
  --display:'Bricolage Grotesque',Georgia,sans-serif;
  --body:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
  --mono:'JetBrains Mono','Fira Code',Consolas,monospace;
  --ease:cubic-bezier(.16,1,.3,1);
  /* default surface = Dim (softer charcoal; also the fallback if no data-theme set) */
  --bg:#161C26; --bg2:#0F141C; --panel:#1F2836; --panel2:#273140; --panel3:#2F3A4A;
  --ink:#EDF1F7; --ink2:#BFC9D8; --muted:#93A0B2; --line:#313C4C; --line2:#3E4A5B;
}
/* ---- darkness levels (switchable in the sidebar) ---- */
html[data-theme="dim"]{--bg:#161C26; --bg2:#0F141C; --panel:#1F2836; --panel2:#273140; --panel3:#2F3A4A;
  --ink:#EDF1F7; --ink2:#BFC9D8; --muted:#93A0B2; --line:#313C4C; --line2:#3E4A5B;}
html[data-theme="dark"]{--bg:#10151D; --bg2:#0A0E15; --panel:#18202B; --panel2:#202A36; --panel3:#28323F;
  --ink:#E9EEF5; --ink2:#B8C2D1; --muted:#8B97A8; --line:#28313F; --line2:#35414F;}
html[data-theme="midnight"]{--bg:#090C12; --bg2:#05070B; --panel:#10151D; --panel2:#161D28; --panel3:#1E2732;
  --ink:#E6ECF4; --ink2:#AEB9C8; --muted:#828FA1; --line:#212A37; --line2:#2C3644;}
/* Light mode — the warm cream palette, same notebook layout */
html[data-theme="light"]{
  --bg:#FAF7F2; --bg2:#F1EBE0; --panel:#FFFFFF; --panel2:#FBF7F0; --panel3:#F3EDE3;
  --ink:#2C2A28; --ink2:#55504A; --muted:#6E675F; --line:#E5DFD6; --line2:#D8D0C4;
  --accent:#2A7B9B; --accent-d:#1F6280; --accent-soft:#E4F2F7; --on-soft:#1F6280;
  --q:#1F6280; --k:#5E5191; --v:#9A5A12;
  --ok:#2D8B55; --ok-ink:#1A5C38; --ok-soft:#E8F5EE; --ok-line:#2D8B55;
  --warn:#A67D08; --warn-soft:#FCF3DC; --warn-line:#A67D08;
  --err:#C93B3B; --err-ink:#8F2020; --err-soft:#FDE8E8; --err-line:#C93B3B;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);color:var(--ink);background:var(--bg);line-height:1.65;font-size:16.5px;
  -webkit-font-smoothing:antialiased;
  background-image:
    radial-gradient(ellipse 110% 55% at 82% -8%,rgba(128,145,255,.10),transparent 60%),
    radial-gradient(ellipse 90% 50% at 6% 108%,rgba(255,155,92,.06),transparent 60%);
  background-attachment:fixed}
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
strong{color:var(--ink);font-weight:600}
code{font-family:var(--mono);font-size:.85em;background:var(--bg2);padding:1px 5px;border-radius:5px;color:var(--q);border:1px solid var(--line)}
::-webkit-scrollbar{width:9px;height:9px}::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--line2);border-radius:var(--r-full)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}

/* ---------- top progress bar ---------- */
#progress-track{position:fixed;top:0;left:0;right:0;height:4px;background:transparent;z-index:60}
#progress-bar{height:100%;width:0%;background:linear-gradient(90deg,var(--q),var(--accent),var(--v));
  transition:width .4s var(--ease);box-shadow:0 0 12px rgba(128,145,255,.5)}

/* ---------- mobile nav toggle ---------- */
#nav-toggle{display:none}

/* ---------- layout ---------- */
.layout{display:flex;align-items:flex-start;max-width:1320px;margin:0 auto}

/* ---------- sidebar ---------- */
#sidebar{position:sticky;top:0;height:100vh;width:288px;flex:0 0 288px;
  display:flex;flex-direction:column;
  padding:22px 0 0;border-right:1px solid var(--line);background:var(--panel)}
.sidebar-scroll{flex:1 1 auto;overflow-y:auto;min-height:0;padding:0 16px}
.brand{padding:6px 8px 14px;border-bottom:1px solid var(--line);margin-bottom:12px}
.brand-title{font-family:var(--display);font-weight:800;font-size:1.2rem;letter-spacing:-.02em}
.brand-dot{color:var(--accent)}
.brand-sub{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-top:2px}
.nav-count{margin-top:10px;font-family:var(--mono);font-size:.82rem;font-weight:600;color:var(--ink2)}
.nav-count b{color:var(--accent)}
.theme-row{padding:10px 8px 0}
.theme-btns{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:6px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:3px}
.theme-btn{flex:1;font-family:var(--body);font-size:.72rem;font-weight:600;color:var(--muted);background:none;border:0;border-radius:7px;padding:5px 4px;cursor:pointer;transition:.15s}
.theme-btn:hover{color:var(--ink)}
.theme-btn.active{background:var(--accent);color:#fff}
/* ---- reading language (EN / 中文), mirroring .theme-* one-for-one ---- */
.lang-row{padding:10px 8px 0}
.lang-btns{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:6px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:3px}
.lang-btn{font-family:var(--body);font-size:.72rem;font-weight:600;color:var(--muted);background:none;border:0;border-radius:7px;padding:5px 4px;cursor:pointer;transition:.15s}
.lang-btn:hover{color:var(--ink)}
.lang-btn.active{background:var(--accent);color:#fff}
.lang-btn[aria-disabled="true"]{opacity:.38;cursor:not-allowed}
.lang-btn[aria-disabled="true"]:hover{color:var(--muted)}
/* One language shows at a time. A block carrying NEITHER class shows under both,
   which is the fallback: a day with no Chinese twin still reads in English
   instead of going blank. No JavaScript is involved in that decision. */
html[data-lang="en"] .lang-zh{display:none}
html[data-lang="zh"] .lang-en{display:none}
/* CJK needs more leading and no letter-spacing to stay readable at this size.
   No new webfont is loaded — the system CJK stack is used, because every lesson
   page must stay self-contained. */
html[data-lang="zh"] .sec-body,html[data-lang="zh"] .lede,html[data-lang="zh"] .goal{line-height:1.9;letter-spacing:0}
html[data-lang="zh"] .sec-h,html[data-lang="zh"] h1,html[data-lang="zh"] h4{letter-spacing:0}
.nav-group-label{font-size:.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.09em;padding:4px 8px;margin-top:10px}
.nav-link{display:flex;align-items:center;gap:.5rem;padding:7px 10px;margin:1px 0;border-radius:9px;color:var(--ink2);
  font-size:.86rem;cursor:pointer;border-left:3px solid transparent;transition:all .12s;background:none;border-top:0;border-right:0;border-bottom:0;width:100%;text-align:left;font-family:var(--body)}
.nav-link:hover{background:var(--panel2);text-decoration:none;color:var(--ink)}
.nav-link.active{background:var(--accent-soft);color:var(--on-soft);font-weight:700;border-left-color:var(--accent)}
.nav-link .nl-dot{width:7px;height:7px;border-radius:50%;background:var(--line2);flex:0 0 auto}
.nav-link.done .nl-dot{background:var(--ok)}
.checklist-wrap{margin-top:16px;border-top:1px solid var(--line);padding-top:12px;padding-bottom:16px}
#checklist{list-style:none;margin:0;padding:0}
#checklist li{display:flex;gap:8px;align-items:flex-start;font-size:.78rem;color:var(--ink2);padding:4px 8px;cursor:pointer;border-radius:7px}
#checklist li:hover{background:var(--panel2)}
#checklist li .box{width:15px;height:15px;border-radius:4px;border:1.5px solid var(--line2);flex:0 0 auto;margin-top:2px;
  display:grid;place-items:center;font-size:.66rem;color:var(--bg);font-weight:800}
#checklist li.done .box{background:var(--ok);border-color:var(--ok)}
#checklist li.done .box::after{content:'✓'}
#checklist li.done span{color:var(--muted);text-decoration:line-through}
.ghost-btn{background:none;border:1px solid var(--line2);color:var(--muted);font-size:.74rem;padding:6px 11px;border-radius:8px;cursor:pointer;margin-top:10px;transition:.15s}
.ghost-btn:hover{border-color:var(--err);color:var(--err)}
.side-nav{flex:0 0 auto;padding:12px 16px 16px;border-top:1px solid var(--line);background:var(--panel2);display:flex;flex-direction:column;gap:6px}
.side-nav a{display:flex;flex-direction:column;gap:1px;padding:8px 10px;border:1px solid var(--line2);border-radius:9px;background:var(--panel);color:var(--ink);transition:.15s}
.side-nav a:hover{border-color:var(--accent);text-decoration:none;transform:translateY(-1px)}
.side-nav .d{font-family:var(--mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.side-nav .t{font-size:.82rem;font-weight:600}

/* ---------- main content ---------- */
#content{flex:1 1 auto;min-width:0;padding:44px clamp(20px,5vw,60px) 80px;max-width:920px}
.hero{border-bottom:1px solid var(--line);padding-bottom:26px;margin-bottom:8px}
.kicker{display:inline-block;font-family:var(--mono);font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--accent);background:var(--accent-soft);padding:5px 12px;border-radius:999px}
.hero h1{font-family:var(--display);font-size:clamp(2rem,4.6vw,2.9rem);letter-spacing:-.03em;margin:.35em 0 .1em;line-height:1.06}
.hero h1 .sub{display:block;font-size:.5em;font-weight:600;color:var(--ink2);margin-top:.35rem;letter-spacing:-.01em}
.lede{font-size:1.1rem;color:var(--ink2);max-width:64ch;line-height:1.55}
.goal{margin-top:1.3rem;display:flex;gap:.8rem;background:linear-gradient(120deg,var(--accent-soft),transparent);
  border:1px solid var(--accent-d);border-radius:var(--r-md);padding:1rem 1.2rem;max-width:80ch}
.goal .gic{font-size:1.2rem;flex:0 0 auto}.goal b{color:var(--accent)}.goal code{color:var(--ink)}

.module-section{padding:30px 0;border-bottom:1px solid var(--line);scroll-margin-top:20px}
.module-section:last-of-type{border-bottom:none}
.sec-head{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.sec-num{flex:0 0 auto;width:32px;height:32px;border-radius:9px;background:var(--accent-soft);color:var(--accent);
  font-family:var(--mono);font-weight:800;display:grid;place-items:center;font-size:.92rem}
.sec-num.s-what{background:rgba(91,155,255,.16);color:var(--q)}
.sec-num.s-study{background:rgba(179,155,255,.16);color:var(--k)}
.sec-num.s-play{background:rgba(255,155,92,.16);color:var(--v)}
.sec-num.s-code{background:rgba(231,176,74,.16);color:var(--warn)}
.sec-num.s-quiz{background:rgba(231,176,74,.16);color:var(--warn)}
.sec-num.s-produce{background:rgba(91,201,138,.16);color:var(--ok)}
.module-section.done .sec-num{background:var(--ok);color:var(--bg)}
.sec-h{font-family:var(--display);font-size:1.4rem;font-weight:700;letter-spacing:-.02em;line-height:1.2;flex:1;min-width:0}
.sec-tag{font-family:var(--mono);font-size:.66rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.sec-body h4{font-family:var(--display);font-size:1.02rem;font-weight:700;color:var(--ink);margin:1.4rem 0 .5rem}
.sec-body h4:first-child{margin-top:0}
.sec-body p{margin-bottom:.9rem;color:var(--ink2)}.sec-body p:last-child{margin-bottom:0}
.sec-body ul,.sec-body ol{margin:0 0 .9rem 1.4rem;color:var(--ink2)}.sec-body li{margin-bottom:.45rem}
.term{border-bottom:1.5px dashed var(--accent);font-weight:500;color:var(--ink);cursor:help}
.term[data-tip]:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px}

/* ---------- cards / callouts ---------- */
.relate{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0}
.relate .card{background:var(--panel2);border:1px solid var(--line2);border-radius:var(--radius);padding:16px 18px;box-shadow:var(--shadow-sm)}
.relate .card h5{font-family:var(--display);font-size:.98rem;font-weight:700;color:var(--ink);margin-bottom:.4rem;display:flex;align-items:center;gap:.5rem}
.relate .card .big{font-size:1.5rem}
.relate .card p{font-size:.88rem;color:var(--ink2);margin:0}
.callout{border-radius:var(--radius);padding:15px 18px;margin:16px 0;border:1px solid var(--line2);background:var(--panel2);
  box-shadow:var(--shadow-sm);display:flex;gap:.8rem;font-size:.92rem;line-height:1.55}
.callout .ic{font-size:1.05rem;flex:0 0 auto;line-height:1.4}
.callout div{color:var(--ink2)}.callout b{color:var(--ink)}
.callout code{background:rgba(128,128,128,.2)}
.c-info{background:linear-gradient(180deg,rgba(91,155,255,.10),transparent);border-color:var(--accent-d)}
.c-warn{background:linear-gradient(180deg,rgba(231,176,74,.10),transparent);border-color:var(--warn-line)}
.c-ok{background:linear-gradient(180deg,rgba(91,201,138,.10),transparent);border-color:var(--ok-line)}
.takeaway{background:var(--panel2);border-left:3px solid var(--accent);padding:11px 15px;border-radius:0 10px 10px 0;font-size:.95rem;margin:14px 0;color:var(--ink2)}

/* ---------- got-it button ---------- */
.gotit{margin-top:1.3rem;display:inline-flex;align-items:center;gap:.5rem;font-family:var(--body);font-size:.92rem;font-weight:700;
  color:#fff;background:var(--accent);border:1.5px solid var(--accent);border-radius:10px;padding:.62rem 1.25rem;cursor:pointer;
  transition:background .18s,transform .1s,box-shadow .18s}
.gotit:hover{background:var(--accent-d);box-shadow:0 6px 20px rgba(128,145,255,.28)}
.gotit:active{transform:translateY(1px)}
.gotit:disabled{opacity:.45;filter:grayscale(.5);cursor:not-allowed;box-shadow:none}
.gotit:disabled:hover{background:var(--accent);transform:none}
.module-section.done .gotit{background:var(--ok);border-color:var(--ok)}

/* ---------- playground (fake terminal) ---------- */
.viz-panel{background:var(--panel);border:1px solid var(--line2);border-radius:var(--radius);padding:18px;margin:18px 0;box-shadow:var(--shadow-sm)}
.play-btns{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.8rem}
.play-btn{font-family:var(--mono);font-size:.8rem;font-weight:500;border:1px solid var(--line2);background:var(--panel2);color:var(--ink2);
  border-radius:var(--r-sm);padding:.5rem .8rem;cursor:pointer;transition:all .15s}
.play-btn:hover{border-color:var(--v);color:var(--ink)}
.play-btn.active{background:var(--v);color:var(--bg2);border-color:var(--v);font-weight:600}
.play-btn.seen:not(.active){border-color:var(--ok);color:var(--ok-ink)}
.play-btn.seen::after{content:' ✓';font-weight:700}
.play-console{background:#080B11;color:#CDD6F4;font-family:var(--mono);font-size:.84rem;line-height:1.7;padding:1rem 1.15rem;
  border-radius:var(--r-md);border:1px solid var(--line);min-height:160px;white-space:pre-wrap;overflow-x:auto}
.play-console .prompt{color:#5C6675}.play-console .kw{color:#C9A9F5}.play-console .str{color:#8FE3A0}
.play-console .num{color:#F0B366}.play-console .fn{color:#7BB5F5}.play-console .ok{color:#8FE3A0}
.play-console .bad{color:#F08B8B}.play-console .dim{color:#8891A0}.play-console .hl{color:#F5DC8A}
.play-take{margin-top:.75rem;padding:.8rem .95rem;font-size:.85rem;background:var(--panel2);border:1px solid var(--line);
  border-radius:var(--r-md);color:var(--ink2);line-height:1.5;min-height:2.4em}
.play-take b{color:var(--ink)}
.hint{font-size:.85rem;color:var(--muted);margin-top:.8rem}

/* ---------- inline demo (V9: generic run-demo widget) ---------- */
.demo{border:1px solid var(--line2);border-radius:var(--r-md);background:var(--panel2);margin:1rem 0;overflow:hidden}
.demo-code{display:flex;align-items:center;gap:.7rem;justify-content:space-between;padding:.7rem .9rem;background:var(--panel);border-bottom:1px solid var(--line)}
.demo-code code{font-family:var(--mono);font-size:.82rem;background:transparent;border:0;color:var(--q);padding:0;flex:1;min-width:0;overflow-x:auto;white-space:pre}
.demo-run{font-family:var(--body);font-size:.78rem;font-weight:700;color:#fff;background:var(--v);border:1px solid var(--v);border-radius:var(--r-sm);padding:.4rem .8rem;cursor:pointer;flex:0 0 auto;transition:.15s}
.demo-run:hover{filter:brightness(1.08)}
.demo-run:disabled{opacity:.55;cursor:default;filter:grayscale(.4)}
.demo-out{margin:0;padding:.85rem 1rem;background:#080B11;color:#8FE3A0;font-family:var(--mono);font-size:.82rem;line-height:1.6;white-space:pre-wrap;overflow-x:auto}
.demo-take{padding:.75rem 1rem;font-size:.85rem;color:var(--ink2);line-height:1.5;background:var(--panel2)}
.demo-take b{color:var(--ink)}
/* ---------- hint ladder (get-unstuck) + warm-up recall (retention) ---------- */
.hint{border:1px solid var(--line2);border-left:3px solid var(--accent);border-radius:var(--r-md);background:var(--panel2);margin:1rem 0;padding:.6rem .9rem}
.hint-reveal{font-family:var(--body);font-size:.82rem;font-weight:700;color:var(--accent);background:transparent;border:1px dashed var(--accent);border-radius:var(--r-sm);padding:.35rem .7rem;cursor:pointer}
.hint-reveal:disabled{opacity:.6;cursor:default;border-style:solid}
.hint-tier{margin-top:.6rem;padding:.55rem .8rem;background:var(--panel);border-radius:var(--r-sm);font-size:.88rem;color:var(--ink2);line-height:1.5}
.warmup{border:1px solid var(--line2);border-radius:var(--r-md);background:var(--panel2);margin:1rem 0;padding:.8rem 1rem}
.warmup .warmup-h{font-weight:700;color:var(--ink);font-size:.9rem;margin-bottom:.5rem}
.warmup .q{margin:.6rem 0}

/* ---------- build (scroll reveal) ---------- */
.build{display:flex;flex-direction:column;gap:1rem;margin:1rem 0}
.build-hint{font-family:var(--mono);font-size:.74rem;letter-spacing:.06em;color:var(--muted);text-align:center;margin:.2rem 0 .5rem}
.build-step{display:grid;grid-template-columns:1fr;gap:.7rem;padding:1.05rem 1.15rem;border:1px solid var(--line2);border-radius:var(--r-md);
  background:var(--panel2);opacity:1;transform:none;transition:opacity .55s var(--ease),transform .55s var(--ease)}
.build.armed .build-step:not(.revealed){opacity:0;transform:translateY(18px)}
.build-viz{display:block;text-align:center;min-height:56px;overflow-x:auto;padding:.7rem;background:#F7F9FB;border-radius:var(--r-sm)}
.build-viz svg{display:inline-block;width:100%;max-width:500px;height:auto;vertical-align:middle}
.build-note{font-size:.9rem;color:var(--ink2);line-height:1.55}.build-note b{color:var(--ink)}.build-note code{background:var(--bg2)}
.build-num{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--accent);color:#fff;
  font-family:var(--mono);font-size:.72rem;font-weight:700;margin-right:.5rem;vertical-align:middle}
.build-embed{border:1px solid var(--line2);border-radius:var(--r-md);overflow:hidden;background:#F7F9FB;margin:1rem 0}
.build-embed iframe{width:100%;height:520px;border:0;display:block;background:#F7F9FB}
.build-embed .cap{display:flex;align-items:center;gap:.6rem;font-family:var(--mono);font-size:.72rem;color:var(--muted);padding:.5rem .8rem;background:var(--panel2);border-top:1px solid var(--line)}
.build-embed .cap a{color:var(--accent)}
.build-embed .cap .reload{margin-left:auto;font-family:var(--body);font-size:.7rem;font-weight:600;color:var(--ink2);background:var(--panel3);border:1px solid var(--line2);border-radius:var(--r-sm);padding:.3rem .6rem;cursor:pointer}
.build-embed .cap .reload:hover{border-color:var(--accent);color:var(--accent)}

/* ---------- quiz ---------- */
.q{margin-bottom:1.6rem}.q:last-child{margin-bottom:0}
.q-ask{font-family:var(--body);font-size:.96rem;font-weight:600;color:var(--ink);margin-bottom:.7rem;line-height:1.4}
.q-opts{display:flex;flex-direction:column;gap:.5rem}
.q-opt{display:flex;align-items:center;gap:.7rem;text-align:left;font-family:var(--body);font-size:.9rem;color:var(--ink2);
  border:1.5px solid var(--line2);background:var(--panel2);border-radius:var(--r-sm);padding:.65rem .9rem;cursor:pointer;transition:all .15s}
.q-opt:hover:not(.locked){border-color:var(--accent);color:var(--ink)}
.q-opt .mark{width:20px;height:20px;border-radius:50%;border:2px solid var(--line2);flex:0 0 auto;display:grid;place-items:center;font-size:.7rem;font-weight:800;color:var(--bg)}
.q-opt.correct{border-color:var(--ok);background:var(--ok-soft);color:var(--ink)}
.q-opt.correct .mark{background:var(--ok);border-color:var(--ok)}.q-opt.correct .mark::after{content:'✓'}
.q-opt.wrong{border-color:var(--err);background:var(--err-soft);color:var(--ink)}
.q-opt.wrong .mark{background:var(--err);border-color:var(--err)}.q-opt.wrong .mark::after{content:'✕'}
.q-opt.locked{cursor:default}
.q-fb{max-height:0;overflow:hidden;opacity:0;transition:max-height .3s,opacity .3s;font-size:.86rem;border-radius:var(--r-sm);line-height:1.5}
.q-fb.show{max-height:360px;opacity:1;padding:.75rem .95rem;margin-top:.5rem}
.q-fb.good{background:var(--ok-soft);color:var(--ok-ink);border:1px solid var(--ok-line)}
.q-fb.bad{background:var(--err-soft);color:var(--err-ink);border:1px solid var(--err-line)}
.q-fb code{background:rgba(128,128,128,.2)}

/* ---------- produce prompt ---------- */
.prompt{border:1px solid var(--line2);border-radius:var(--r-md);overflow:hidden;margin:1rem 0}
.prompt-h{display:flex;align-items:center;justify-content:space-between;gap:.7rem;padding:.55rem .6rem .55rem 1rem;background:var(--panel2);border-bottom:1px solid var(--line)}
.prompt-l{font-family:var(--mono);font-size:.74rem;color:var(--ink2)}.prompt-l b{color:var(--accent)}
.copy{font-family:var(--body);font-size:.74rem;font-weight:600;color:#fff;background:var(--accent);border:none;border-radius:var(--r-sm);padding:.45rem .8rem;cursor:pointer;transition:.15s}
.copy:hover{background:var(--accent-d)}.copy.done{background:var(--ok)}
.prompt-t{margin:0;padding:1rem;background:#080B11;color:#C6D2E0;font-family:var(--mono);font-size:.8rem;line-height:1.6;white-space:pre-wrap;word-break:break-word}

/* ---------- completion banner ---------- */
.fin{margin:1.8rem 0 0;padding:2rem;text-align:center;background:linear-gradient(135deg,var(--ok-soft),var(--accent-soft));
  border:1px solid var(--ok);border-radius:var(--radius);opacity:0;max-height:0;overflow:hidden;transition:opacity .4s,max-height .4s}
.fin.show{opacity:1;max-height:480px;padding:2.2rem 2rem}
.fin .em{font-size:2.6rem;display:block;margin-bottom:.5rem}
.fin h3{font-family:var(--display);font-size:1.5rem;font-weight:700;color:var(--ok-ink);margin-bottom:.5rem}
.fin p{color:var(--ink2);font-size:.92rem;margin:0}.fin b{color:var(--ink)}.fin code{background:rgba(0,0,0,.35)}

.site-footer{margin-top:36px;padding-top:20px;border-top:1px solid var(--line);font-size:.8rem;color:var(--muted);line-height:1.6}

/* ---------- tooltip ---------- */
#term-tip{position:fixed;z-index:1000;max-width:min(300px,92vw);background:#080B11;color:#EDEAFE;font-family:var(--body);font-size:.82rem;
  font-weight:400;line-height:1.45;text-align:left;padding:.6rem .78rem;border-radius:var(--r-md);border:1px solid var(--line2);
  box-shadow:var(--shadow);pointer-events:none;opacity:0;transform:translateY(3px);transition:opacity .15s var(--ease),transform .15s var(--ease)}
#term-tip.show{opacity:1;transform:translateY(0)}
#term-tip .ttl{display:block;font-family:var(--mono);font-size:.66rem;letter-spacing:.05em;text-transform:uppercase;color:var(--accent);margin-bottom:.2rem}

/* ---------- responsive ---------- */
#scrim{display:none}
@media(max-width:900px){
  .layout{display:block}
  #sidebar{position:fixed;z-index:70;top:0;left:0;transform:translateX(-100%);transition:transform .22s var(--ease);
    box-shadow:var(--shadow);width:290px;height:100vh}
  #sidebar.open{transform:translateX(0)}
  #nav-toggle{display:inline-flex;align-items:center;gap:.4rem;position:fixed;top:12px;right:12px;z-index:65;
    background:var(--accent);color:#fff;border:none;padding:9px 15px;border-radius:10px;font-weight:700;font-family:var(--body);font-size:.85rem;cursor:pointer;box-shadow:var(--shadow)}
  #scrim.show{display:block;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:69}
  #content{padding:60px 18px 70px;max-width:100%}
  .relate{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
</style>
</head>

<body data-quest-id="__QUEST_ID__">

<div id="progress-track" aria-hidden="true"><div id="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="lesson progress"></div></div>
<button id="nav-toggle" type="button" aria-label="Toggle sections" aria-expanded="false">☰ Sections</button>
<div id="scrim" aria-hidden="true"></div>

<div class="layout">

  <!-- ============ SIDEBAR ============ -->
  <aside id="sidebar" aria-label="lesson navigation">
    <div class="sidebar-scroll">
    <div class="brand">
      <div class="brand-title">Frontier<span class="brand-dot">.</span>Lab</div>
      <div class="brand-sub">Foundations · M2 Day 2</div>
      <div class="nav-count" id="count"><b>0</b>/7 sections done</div>
    </div>

    <div class="theme-row" role="group" aria-label="appearance mode">
      <span class="nav-group-label" style="padding:0">Appearance</span>
      <div class="theme-btns">
        <button class="theme-btn" data-theme-set="light" type="button">Light</button>
        <button class="theme-btn" data-theme-set="dim" type="button">Dim</button>
        <button class="theme-btn" data-theme-set="dark" type="button">Dark</button>
        <button class="theme-btn" data-theme-set="midnight" type="button">Midnight</button>
      </div>
    </div>

    <div class="lang-row" role="group" aria-label="reading language">
      <span class="nav-group-label" style="padding:0">Language · 语言</span>
      <div class="lang-btns">
        <button class="lang-btn" data-lang-set="en" type="button">English</button>
        <button class="lang-btn" data-lang-set="zh" type="button">中文</button>
      </div>
    </div>

    <nav aria-label="Sections">
<!--V9_NAV-->
    </nav>

    <div class="checklist-wrap">
      <div class="nav-group-label">Progress checklist</div>
      <ul id="checklist"><!-- built by JS --></ul>
      <button id="reset" class="ghost-btn" type="button">↺ Reset progress</button>
    </div>
    </div><!-- /.sidebar-scroll -->

    <div class="side-nav">
      <a class="lnav prev" href="../day-01-single-neuron/lesson.html"><span class="d">← Prev</span><span class="t">A Single Neuron</span></a>
      <a class="lnav next" href="../day-03-layers-forward-pass/lesson.html"><span class="d">Next →</span><span class="t">Layers &amp; the Forward Pass</span></a>
      <a class="lnav-hub" href="../../index.html"><span class="d">▦ Map</span><span class="t">Back to curriculum</span></a>
    </div>
  </aside>

  <!-- ============ MAIN CONTENT ============ -->
  <main id="content">

    <!--V9_CONTENT-->

    <footer class="site-footer">Frontier Lab · Foundations — a fully self-contained single file. Progress is saved locally in your browser (localStorage), works offline, just double-click to open.</footer>

  </main>
</div>

<script>
(function(){
"use strict";
var QID = document.body.getAttribute('data-quest-id') || 'quest';
var KEY = 'frontier-lesson:'+QID;
var state = load();
function load(){ try{ return JSON.parse(localStorage.getItem(KEY))||{done:{}} }catch(e){ return {done:{}} } }
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)) }catch(e){} }

var secs = Array.prototype.slice.call(document.querySelectorAll('.module-section'));
var bar = document.getElementById('bar') || document.getElementById('progress-bar');
var count = document.getElementById('count'), fin = document.getElementById('fin');
var RM = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
var navLinks = Array.prototype.slice.call(document.querySelectorAll('.nav-link'));

/* ---- build the sidebar checklist from sections ---- */
var checklist = document.getElementById('checklist'), checkItems = {}, _lblLang = null;
function secLabel(sec){
  /* A .sec-h can hold a paired <span class="lang-en">/<span class="lang-zh">. Reading
     the whole node's textContent would splice BOTH languages into one label, e.g.
     "The bend这个弯" — display:none hides a span visually but textContent still
     returns it. So read the one span for the current language, falling back to
     English, and to the whole node on a page with no pairs at all. */
  var h = sec.querySelector('.sec-h');
  if(!h) return sec.getAttribute('data-sec');
  var cur = document.documentElement.getAttribute('data-lang') || 'en';
  return (h.querySelector('.lang-'+cur) || h.querySelector('.lang-en') || h).textContent;
}
function buildChecklist(){
  if(!checklist) return;
  checklist.innerHTML = ''; checkItems = {};
  secs.forEach(function(sec){
    var key = sec.getAttribute('data-sec');
    var num = sec.querySelector('.sec-num') ? sec.querySelector('.sec-num').textContent : '';
    var li = document.createElement('li');
    li.innerHTML = '<span class="box" aria-hidden="true"></span><span>'+num+' · '+shorten(secLabel(sec))+'</span>';
    li.addEventListener('click', function(){ sec.scrollIntoView({behavior:RM?'auto':'smooth', block:'start'}); });
    checklist.appendChild(li);
    checkItems[key] = li;
  });
  _lblLang = document.documentElement.getAttribute('data-lang') || 'en';
}
buildChecklist();
function shorten(t){ return t.length>34 ? t.slice(0,32).trim()+'…' : t; }

function markDone(sec, scrollNext){
  sec.classList.add('done'); state.done[sec.getAttribute('data-sec')]=true; save(); refresh();
  if(scrollNext){
    var i = secs.indexOf(sec);
    if(i>-1 && i+1<secs.length) setTimeout(function(){ secs[i+1].scrollIntoView({behavior:RM?'auto':'smooth',block:'start'}); },180);
    else setTimeout(function(){ fin.scrollIntoView({behavior:RM?'auto':'smooth',block:'center'}); },180);
  }
}
secs.forEach(function(sec){
  if(state.done[sec.getAttribute('data-sec')]) sec.classList.add('done');
  var btn = sec.querySelector('.gotit');
  if(btn) btn.addEventListener('click', function(){ markDone(sec, true); });
});
function refresh(){
  var total = secs.length, done = secs.filter(function(s){return s.classList.contains('done')}).length;
  var pct = Math.round(done/total*100);
  if(bar){ bar.style.width = pct+'%'; bar.setAttribute('aria-valuenow', String(pct)); bar.setAttribute('aria-valuetext', pct+'% complete'); }
  if(count) count.innerHTML = '<b>'+done+'</b>/'+total+' sections done';
  secs.forEach(function(s){
    var k = s.getAttribute('data-sec'), on = s.classList.contains('done');
    if(checkItems[k]) checkItems[k].classList.toggle('done', on);
    var nl = navLinks.filter(function(l){return l.getAttribute('data-target')===s.id;})[0];
    if(nl) nl.classList.toggle('done', on);
  });
  var all = done===total; if(fin){ fin.classList.toggle('show', all); fin.setAttribute('aria-hidden', all?'false':'true'); }
}
var resetBtn = document.getElementById('reset');
if(resetBtn) resetBtn.addEventListener('click', function(){
  if(!confirm('Reset today\'s progress?')) return;
  state={done:{}}; save(); secs.forEach(function(s){s.classList.remove('done')}); refresh();
});

/* ---- darkness switcher ---- */
var themeBtns = Array.prototype.slice.call(document.querySelectorAll('.theme-btn'));
function setTheme(t){
  document.documentElement.setAttribute('data-theme', t);
  try{ localStorage.setItem('frontier-theme', t); }catch(e){}
  themeBtns.forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-theme-set')===t); });
}
themeBtns.forEach(function(b){ b.addEventListener('click', function(){ setTheme(b.getAttribute('data-theme-set')); }); });
setTheme(document.documentElement.getAttribute('data-theme') || 'dim');

/* ---- reading-language switcher (English / 中文) ---- */
/* Mirrors setTheme: flip an attribute on <html>, let CSS do the rest, remember the
   choice. Two things it must get right that setTheme does not have to:
     * <html lang> moves too, not just data-lang. A screen reader on a page marked
       lang="en" reads CJK with an English voice, which is worse than not
       translating it at all.
     * a page with no Chinese content must NOT persist a forced fallback. Without
       that guard, opening one untranslated day would silently reset the reader's
       language for the whole site. */
var langBtns = Array.prototype.slice.call(document.querySelectorAll('.lang-btn'));
var hasZh = !!document.querySelector('.lang-zh');
function setLang(l, persist){
  if(l==='zh' && !hasZh){ l='en'; persist=false; }
  document.documentElement.setAttribute('data-lang', l);
  document.documentElement.setAttribute('lang', l==='zh' ? 'zh-Hans' : 'en');
  if(persist!==false){ try{ localStorage.setItem('frontier-lang', l); }catch(e){} }
  langBtns.forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-lang-set')===l); });
  /* checklist labels are language-dependent; rebuild only on a real change */
  if(_lblLang !== l){ buildChecklist(); refresh(); }
}
langBtns.forEach(function(b){
  if(b.getAttribute('data-lang-set')==='zh' && !hasZh){
    b.setAttribute('aria-disabled','true');
    b.setAttribute('title','中文版尚未提供 — no Chinese on this page yet');
  }
  b.addEventListener('click', function(){ setLang(b.getAttribute('data-lang-set')); });
});
setLang(document.documentElement.getAttribute('data-lang') || 'en', false);

/* ---- sidebar nav: click to scroll, scrollspy to highlight active ---- */
navLinks.forEach(function(l){
  l.addEventListener('click', function(){
    var t = document.getElementById(l.getAttribute('data-target'));
    if(t) t.scrollIntoView({behavior:RM?'auto':'smooth', block:'start'});
    setTimeout(function(){ if(window.__revealBuild) window.__revealBuild(); }, RM?60:650);
    closeSidebar();
  });
});
var spyTargets = [document.getElementById('home')].concat(secs).filter(Boolean);
if('IntersectionObserver' in window){
  var spy = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(e.isIntersecting){
        var id = e.target.id;
        navLinks.forEach(function(l){ l.classList.toggle('active', l.getAttribute('data-target')===id); });
      }
    });
  }, {threshold:0.01, rootMargin:'-45% 0px -50% 0px'});
  spyTargets.forEach(function(t){ spy.observe(t); });
}

/* ---- mobile sidebar toggle ---- */
var sidebar = document.getElementById('sidebar'), toggle = document.getElementById('nav-toggle'), scrim = document.getElementById('scrim');
function openSidebar(){ sidebar.classList.add('open'); scrim.classList.add('show'); toggle.setAttribute('aria-expanded','true'); }
function closeSidebar(){ sidebar.classList.remove('open'); scrim.classList.remove('show'); toggle.setAttribute('aria-expanded','false'); }
if(toggle) toggle.addEventListener('click', function(){ sidebar.classList.contains('open')?closeSidebar():openSidebar(); });
if(scrim) scrim.addEventListener('click', closeSidebar);

/* ===== INLINE DEMOS (generic; any number, any section) ===== */
Array.prototype.slice.call(document.querySelectorAll('.demo')).forEach(function(d){
  var run = d.querySelector('.demo-run'), out = d.querySelector('.demo-out'), take = d.querySelector('.demo-take');
  if(!run) return;
  run.addEventListener('click', function(){
    if(out) out.hidden = false;
    if(take) take.hidden = false;
    run.disabled = true; run.textContent = 'ran ✓';
  });
});
/* ===== QUIZ (generic; reads compiler-emitted .q blocks) ===== */
Array.prototype.slice.call(document.querySelectorAll('.quiz')).forEach(function(quizWrap){
  var quizSec = quizWrap.closest('.module-section');
  var qs = Array.prototype.slice.call(quizWrap.querySelectorAll('.q'));
  var answered = {};
  qs.forEach(function(q, qi){
    var correct = parseInt(q.getAttribute('data-correct'), 10);
    var fb = q.querySelector('.q-fb'), fbText = fb ? fb.getAttribute('data-fb') : '';
    var opts = Array.prototype.slice.call(q.querySelectorAll('.q-opt'));
    opts.forEach(function(o, oi){
      o.addEventListener('click', function(){
        if(answered[qi]) return; answered[qi] = true;
        opts.forEach(function(c){ c.classList.add('locked'); });
        if(oi === correct){ o.classList.add('correct'); fb.className='q-fb good show'; fb.innerHTML='✓ '+fbText; }
        else { o.classList.add('wrong'); opts[correct].classList.add('correct'); fb.className='q-fb bad show'; fb.innerHTML='The correct answer is the green one. '+fbText; }
        if(Object.keys(answered).length >= qs.length){ var g = quizSec.querySelector('.gotit'); if(g){ g.disabled=false; g.textContent='All answered — check ✓'; } }
      });
    });
  });
});

/* ===== HINT LADDER (get-unstuck; progressive disclosure, offline — no network) ===== */
Array.prototype.slice.call(document.querySelectorAll('.hint')).forEach(function(h){
  var btn = h.querySelector('.hint-reveal');
  var tiers = Array.prototype.slice.call(h.querySelectorAll('.hint-tier'));
  var shown = 0;
  if(!btn || !tiers.length) return;
  btn.addEventListener('click', function(){
    if(shown < tiers.length){ tiers[shown].hidden = false; shown++; }
    if(shown >= tiers.length){ btn.disabled = true; btn.textContent = "— that's all the hints —"; }
    else { btn.textContent = '💡 still stuck? another hint ('+shown+'/'+tiers.length+')'; }
  });
});
/* ===== SM-2 spaced repetition (retention; browser mirror of coach/core.py:667-714) ===== */
function _srToday(){ return Math.floor(Date.now()/86400000); }
function srReview(conceptId, quality){
  if(!state.sr) state.sr = {};
  var prev = state.sr[conceptId] || {},
      ease = prev.ease!=null?prev.ease:2.5, interval = prev.interval!=null?prev.interval:1, reps = prev.reps!=null?prev.reps:0;
  var ne = Math.max(1.3, ease + 0.1 - (5-quality)*(0.08+(5-quality)*0.02)), ni;
  if(quality>=3){ ni = reps===0?1:(reps===1?6:Math.round(interval*ne)); }
  else { ni = 1; ne = 2.5; }
  state.sr[conceptId] = { ease: Math.round(ne*1000)/1000, interval: ni, next: _srToday()+ni, reps: reps+1 };
  save();
}
/* ===== WARM-UP recall (retention; reuses .q markup, records SM-2 on answer) ===== */
Array.prototype.slice.call(document.querySelectorAll('.warmup .q')).forEach(function(q){
  var correct = parseInt(q.getAttribute('data-correct'),10), cid = q.getAttribute('data-concept')||'';
  var fb = q.querySelector('.q-fb'), fbText = fb?fb.getAttribute('data-fb'):'';
  var opts = Array.prototype.slice.call(q.querySelectorAll('.q-opt')), done=false;
  opts.forEach(function(o,oi){ o.addEventListener('click', function(){
    if(done) return; done=true; opts.forEach(function(c){ c.classList.add('locked'); });
    var right = oi===correct;
    if(right){ o.classList.add('correct'); if(fb){ fb.className='q-fb good show'; fb.innerHTML='✓ '+fbText; } }
    else { o.classList.add('wrong'); if(opts[correct]) opts[correct].classList.add('correct'); if(fb){ fb.className='q-fb bad show'; fb.innerHTML='The green one. '+fbText; } }
    if(cid) srReview(cid, right?5:1);
  }); });
});

/* ===== COPY ===== */
Array.prototype.slice.call(document.querySelectorAll('.copy')).forEach(function(btn){
  btn.addEventListener('click', function(){
    var t=document.querySelector(btn.getAttribute('data-copy')), txt=t?t.textContent.trim():'';
    var done=function(ok){ var o=btn.textContent; btn.textContent=ok?'✓ copied':'select & copy manually'; btn.classList.toggle('done',ok); setTimeout(function(){btn.textContent=o;btn.classList.remove('done')},1600); };
    if(navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(txt).then(function(){done(true)},function(){legacy(txt,done)});
    else legacy(txt,done);
  });
});
function legacy(txt,cb){ try{ var ta=document.createElement('textarea'); ta.value=txt; ta.style.position='fixed'; ta.style.top='-1000px'; document.body.appendChild(ta); ta.select(); var ok=document.execCommand('copy'); document.body.removeChild(ta); cb(ok); }catch(e){ cb(false); } }

/* ===== BUILD scroll-reveal (the "steps" build-up widget assembles as you scroll;
   mirror of shells/js/reveal.js) — multi-container + decoupled from .gotit/#s5.
   Graceful: reduced-motion or no IntersectionObserver reveals every .build-step at
   once (never hidden). Idempotent. */
window.__revealBuild = function(){
  var hasIO = ('IntersectionObserver' in window);
  var builds = Array.prototype.slice.call(document.querySelectorAll('.build'));
  builds.forEach(function(c){
    if(c.classList.contains('armed')) return;
    var steps = Array.prototype.slice.call(c.querySelectorAll('.build-step'));
    if(RM || !hasIO){ steps.forEach(function(s){ s.classList.add('revealed'); }); return; }
    c.classList.add('armed');
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('revealed'); obs.unobserve(e.target); } });
    }, { threshold: 0.25 });
    steps.forEach(function(s){ obs.observe(s); });
  });
};

refresh();
window.__revealBuild();
})();
</script>

<!-- ── glossary tooltips ── -->
<script>
(function(){
  "use strict";
  var terms = document.querySelectorAll('.term[data-tip]');
  if(!terms.length) return;
  var tip = document.createElement('div');
  tip.id = 'term-tip'; tip.setAttribute('role','tooltip');
  document.body.appendChild(tip);
  var active = null;
  function position(el){
    var r = el.getBoundingClientRect();
    tip.style.left = '0px'; tip.style.top = '0px';
    var t = tip.getBoundingClientRect(), pad = 8;
    var left = r.left + r.width/2 - t.width/2;
    left = Math.max(pad, Math.min(left, window.innerWidth - t.width - pad));
    var top = r.top - t.height - pad;
    if(top < pad) top = r.bottom + pad;
    tip.style.left = Math.round(left)+'px';
    tip.style.top  = Math.round(top)+'px';
  }
  function show(el){
    active = el; tip.textContent = '';
    var ttl = document.createElement('span'); ttl.className = 'ttl';
    ttl.textContent = (el.textContent||'').replace(/[.:,;]+$/,'').trim();
    var body = document.createElement('span'); body.textContent = el.getAttribute('data-tip');
    tip.appendChild(ttl); tip.appendChild(body); tip.classList.add('show'); position(el);
  }
  function hide(){ active = null; tip.classList.remove('show'); }
  Array.prototype.forEach.call(terms, function(el){
    if(!el.hasAttribute('tabindex')) el.setAttribute('tabindex','0');
    el.addEventListener('mouseenter', function(){ show(el); });
    el.addEventListener('mouseleave', hide);
    el.addEventListener('focus', function(){ show(el); });
    el.addEventListener('blur', hide);
  });
  window.addEventListener('scroll', function(){ if(active) position(active); }, {passive:true});
  window.addEventListener('resize', function(){ if(active) position(active); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') hide(); });
})();
</script>

<!-- ── viz iframe: auto-size to content + manual reload safety net ──
     Root cause of the earlier "blank box" was Safari treating each local file://
     path as its own origin, so an iframe embedded from a *different* file gets its
     paint suppressed as a privacy measure — confirmed by: it worked standalone,
     it worked in Chrome, and it worked over http://localhost. Not a code bug, and
     it does not affect the deployed (https) site. Auto-resize restored; the reload
     button stays as a harmless safety net regardless of browser. -->
<script>
(function(){
  window.addEventListener('message', function(e){
    var d = e.data;
    if (!d || d.type !== 'viz-height' || typeof d.px !== 'number') return;
    var frames = document.querySelectorAll('.build-embed iframe');
    for (var i = 0; i < frames.length; i++){
      if (frames[i].contentWindow === e.source){
        frames[i].style.height = Math.min(Math.max(d.px, 320), 3200) + 'px';
        break;
      }
    }
  });
  var btn = document.getElementById('bcastReload');
  if(btn) btn.addEventListener('click', function(){
    var f = document.getElementById('bcastFrame');
    if(f) f.src = f.src;
  });
})();
</script>
</body>
</html>
