  </main>
</div>

<script>
(function(){
"use strict";
var QID = document.body.getAttribute('data-quest-id') || 'quest';
var KEY = 'frontier-lesson:'+QID;
var state = load();
function load(){ try{ return JSON.parse(localStorage.getItem(KEY))||{done:{}} }catch(e){ return {done:{}} } }
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)) }catch(e){} }

var secs = Array.prototype.slice.call(document.querySelectorAll('.module-section'));
var bar = document.getElementById('bar') || document.getElementById('progress-bar');
var count = document.getElementById('count'), fin = document.getElementById('fin');
var RM = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
var navLinks = Array.prototype.slice.call(document.querySelectorAll('.nav-link'));

/* ---- build the sidebar checklist from sections ---- */
var checklist = document.getElementById('checklist'), checkItems = {};
secs.forEach(function(sec){
  var key = sec.getAttribute('data-sec');
  var title = sec.querySelector('.sec-h') ? sec.querySelector('.sec-h').textContent : key;
  var num = sec.querySelector('.sec-num') ? sec.querySelector('.sec-num').textContent : '';
  var li = document.createElement('li');
  li.innerHTML = '<span class="box" aria-hidden="true"></span><span>'+num+' · '+shorten(title)+'</span>';
  li.addEventListener('click', function(){ sec.scrollIntoView({behavior:RM?'auto':'smooth', block:'start'}); });
  checklist.appendChild(li);
  checkItems[key] = li;
});
function shorten(t){ return t.length>34 ? t.slice(0,32).trim()+'…' : t; }

function markDone(sec, scrollNext){
  sec.classList.add('done'); state.done[sec.getAttribute('data-sec')]=true; save(); refresh();
  if(scrollNext){
    var i = secs.indexOf(sec);
    if(i>-1 && i+1<secs.length) setTimeout(function(){ secs[i+1].scrollIntoView({behavior:RM?'auto':'smooth',block:'start'}); },180);
    else setTimeout(function(){ fin.scrollIntoView({behavior:RM?'auto':'smooth',block:'center'}); },180);
  }
}
secs.forEach(function(sec){
  if(state.done[sec.getAttribute('data-sec')]) sec.classList.add('done');
  var btn = sec.querySelector('.gotit');
  if(btn) btn.addEventListener('click', function(){ markDone(sec, true); });
});
function refresh(){
  var total = secs.length, done = secs.filter(function(s){return s.classList.contains('done')}).length;
  var pct = Math.round(done/total*100);
  if(bar){ bar.style.width = pct+'%'; bar.setAttribute('aria-valuenow', String(pct)); bar.setAttribute('aria-valuetext', pct+'% complete'); }
  if(count) count.innerHTML = '<b>'+done+'</b>/'+total+' sections done';
  secs.forEach(function(s){
    var k = s.getAttribute('data-sec'), on = s.classList.contains('done');
    if(checkItems[k]) checkItems[k].classList.toggle('done', on);
    var nl = navLinks.filter(function(l){return l.getAttribute('data-target')===s.id;})[0];
    if(nl) nl.classList.toggle('done', on);
  });
  var all = done===total; fin.classList.toggle('show', all); fin.setAttribute('aria-hidden', all?'false':'true');
}
var resetBtn = document.getElementById('reset');
if(resetBtn) resetBtn.addEventListener('click', function(){
  if(!confirm('Reset today\'s progress?')) return;
  state={done:{}}; save(); secs.forEach(function(s){s.classList.remove('done')}); refresh();
});

/* ---- darkness switcher ---- */
var themeBtns = Array.prototype.slice.call(document.querySelectorAll('.theme-btn'));
function setTheme(t){
  document.documentElement.setAttribute('data-theme', t);
  try{ localStorage.setItem('frontier-theme', t); }catch(e){}
  themeBtns.forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-theme-set')===t); });
}
themeBtns.forEach(function(b){ b.addEventListener('click', function(){ setTheme(b.getAttribute('data-theme-set')); }); });
setTheme(document.documentElement.getAttribute('data-theme') || 'dim');

/* ---- sidebar nav: click to scroll, scrollspy to highlight active ---- */
navLinks.forEach(function(l){
  l.addEventListener('click', function(){
    var t = document.getElementById(l.getAttribute('data-target'));
    if(t) t.scrollIntoView({behavior:RM?'auto':'smooth', block:'start'});
    setTimeout(function(){ if(window.__revealBuild) window.__revealBuild(); }, RM?60:650);
    closeSidebar();
  });
});
var spyTargets = [document.getElementById('home')].concat(secs).filter(Boolean);
if('IntersectionObserver' in window){
  var spy = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(e.isIntersecting){
        var id = e.target.id;
        navLinks.forEach(function(l){ l.classList.toggle('active', l.getAttribute('data-target')===id); });
      }
    });
  }, {threshold:0.01, rootMargin:'-45% 0px -50% 0px'});
  spyTargets.forEach(function(t){ spy.observe(t); });
}

/* ---- mobile sidebar toggle ---- */
var sidebar = document.getElementById('sidebar'), toggle = document.getElementById('nav-toggle'), scrim = document.getElementById('scrim');
function openSidebar(){ sidebar.classList.add('open'); scrim.classList.add('show'); toggle.setAttribute('aria-expanded','true'); }
function closeSidebar(){ sidebar.classList.remove('open'); scrim.classList.remove('show'); toggle.setAttribute('aria-expanded','false'); }
if(toggle) toggle.addEventListener('click', function(){ sidebar.classList.contains('open')?closeSidebar():openSidebar(); });
if(scrim) scrim.addEventListener('click', closeSidebar);

/* ===== PLAYGROUND ===== */
var DEMOS = {
  data:{html:'<span class="prompt">&gt;&gt;&gt;</span> image.shape        <span class="dim"># one MNIST digit, 28x28 pixels</span>\n'+
    '<span class="hl">(28, 28)</span>\n'+
    '<span class="prompt">&gt;&gt;&gt;</span> x = image.reshape(<span class="num">784</span>)   <span class="dim"># flatten to a vector (M1 Day 1)</span>\n'+
    '<span class="prompt">&gt;&gt;&gt;</span> x.shape, label\n'+
    '<span class="hl">((784,), 7)</span>',
    take:'<b>①  An image is just numbers.</b> A 28×28 digit flattens to 784 values (M1 Day 1). Its label is the true digit — here 7. There are 60,000 to train on and 10,000 held out to test.'},
  model:{html:'<span class="prompt">&gt;&gt;&gt;</span> <span class="dim"># a 2-layer MLP: 784 -> 128 -> 10</span>\n'+
    '<span class="prompt">&gt;&gt;&gt;</span> h = relu(x @ W1 + b1)     <span class="dim"># (784,)@(784,128) -> (128,)  [M2]</span>\n'+
    '<span class="prompt">&gt;&gt;&gt;</span> logits = h @ W2 + b2      <span class="dim"># (128,)@(128,10) -> (10,)</span>\n'+
    '<span class="prompt">&gt;&gt;&gt;</span> logits.shape, logits.argmax()\n'+
    '<span class="hl">((10,), 7)</span>',
    take:'<b>②  The model is the M2 forward pass.</b> 784 → 128 (ReLU) → 10. The 10 outputs are scores for digits 0–9; the highest (argmax) is the prediction — here it guessed 7.'},
  train:{html:'<span class="prompt">&gt;&gt;&gt;</span> <span class="kw">for</span> epoch <span class="kw">in</span> range(<span class="num">5</span>):   <span class="dim"># M3 loop: forward -> loss -> backprop -> update</span>\n'+
    '<span class="dim">...</span>     train_epoch(); print(epoch, round(loss,<span class="num">3</span>), f<span class="str">"{test_acc:.1%}"</span>)\n'+
    '<span class="ok">0 0.42 91.2%</span>\n<span class="ok">1 0.28 94.1%</span>\n<span class="ok">2 0.22 95.3%</span>\n<span class="ok">3 0.19 96.0%</span>\n<span class="ok">4 0.17 96.5%</span>',
    take:'<b>③  Train, and it learns to read.</b> Running the M3 loop over the digits: loss falls and test accuracy climbs to ~96% on images it never saw. A working model, built only from M1–M4 pieces.'}
};
var playSec=document.getElementById('s3'), consoleEl=document.getElementById('console'), takeEl=document.getElementById('take');
var playBtns=Array.prototype.slice.call(playSec.querySelectorAll('.play-btn')), playSeen={};
playBtns.forEach(function(b){ b.addEventListener('click', function(){
  var k=b.getAttribute('data-demo');
  playBtns.forEach(function(o){o.classList.remove('active')}); b.classList.add('active'); b.classList.add('seen');
  consoleEl.innerHTML=DEMOS[k].html; takeEl.innerHTML=DEMOS[k].take; playSeen[k]=true;
  if(Object.keys(playSeen).length>=3){ var g=playSec.querySelector('.gotit'); g.disabled=false; g.textContent='Saw all three — got it ✓'; }
}); });

/* ===== BUILD — scroll-reveal ===== */
var BUILD=[
 {viz:"<svg viewBox='0 0 520 120' role='img' aria-label='A 28 by 28 digit image flattened to a length 784 vector'><g font-family='monospace' font-size='11.5' text-anchor='middle'><rect x='60' y='30' width='60' height='60' rx='4' fill='#EDE9F8' stroke='#7C6DAA' stroke-width='2'/><text x='90' y='66' fill='#5E5191'>28×28</text><text x='160' y='64' fill='#6B645E'>reshape →</text><rect x='230' y='48' width='250' height='24' rx='4' fill='#E4F2F7' stroke='#2A7B9B' stroke-width='2'/><text x='355' y='65' fill='#1F6280'>x  (784 numbers)</text></g></svg>",
  note:"<b>Start with a digit.</b> A 28×28 image is a grid of pixel brightnesses. Flatten it (M1 Day 1) into one long vector of 784 numbers — that's the model's input."},
 {viz:"<svg viewBox='0 0 520 100' role='img' aria-label='Layer 1 maps 784 to 128 with ReLU'><g font-family='monospace' font-size='12' text-anchor='middle'><rect x='40' y='40' width='90' height='30' rx='5' fill='#E4F2F7' stroke='#2A7B9B' stroke-width='2'/><text x='85' y='60' fill='#1F6280'>x (784)</text><text x='145' y='60' fill='#6B645E'>@ W1 + b1, ReLU →</text><rect x='320' y='40' width='150' height='30' rx='5' fill='#E8F5EE' stroke='#2D8B55' stroke-width='2'/><text x='395' y='60' fill='#1a5c38'>hidden (128)</text></g></svg>",
  note:"<b>Layer 1.</b> <code>relu(x @ W1 + b1)</code> maps the 784 inputs to 128 hidden features (M2). This layer learns useful combinations of pixels — edges, strokes, curves."},
 {viz:"<svg viewBox='0 0 520 100' role='img' aria-label='Layer 2 maps 128 to 10 digit scores'><g font-family='monospace' font-size='12' text-anchor='middle'><rect x='40' y='40' width='120' height='30' rx='5' fill='#E8F5EE' stroke='#2D8B55' stroke-width='2'/><text x='100' y='60' fill='#1a5c38'>hidden (128)</text><text x='175' y='60' fill='#6B645E'>@ W2 + b2 →</text><rect x='300' y='40' width='170' height='30' rx='5' fill='#FCF3DC' stroke='#C99A12' stroke-width='2'/><text x='385' y='60' fill='#9A7208'>logits (10 digit scores)</text></g></svg>",
  note:"<b>Layer 2 → 10 scores.</b> <code>h @ W2 + b2</code> produces one score per digit 0–9. These raw scores are called logits; the biggest one is the model's guess."},
 {viz:"<svg viewBox='0 0 520 110' role='img' aria-label='Softmax turns logits into probabilities, argmax picks the digit'><g font-family='monospace' font-size='12' text-anchor='middle'><rect x='40' y='42' width='120' height='30' rx='5' fill='#FCF3DC' stroke='#C99A12' stroke-width='2'/><text x='100' y='62' fill='#9A7208'>logits (10)</text><text x='185' y='62' fill='#6B645E'>softmax →</text><rect x='270' y='42' width='120' height='30' rx='5' fill='#E4F2F7' stroke='#2A7B9B' stroke-width='2'/><text x='330' y='62' fill='#1F6280'>probs</text><text x='420' y='62' fill='#1a5c38' font-weight='bold'>argmax → 7</text></g></svg>",
  note:"<b>Softmax → a prediction.</b> Softmax (M4 Day 3) turns the 10 logits into probabilities that sum to 1; the largest is the predicted digit. Here the model says 7."},
 {viz:"<svg viewBox='0 0 520 110' role='img' aria-label='Cross-entropy loss then the training loop'><g font-family='monospace' font-size='11.5' text-anchor='middle'><rect x='30' y='42' width='150' height='30' rx='5' fill='#FDE8E8' stroke='#C93B3B' stroke-width='2'/><text x='105' y='62' fill='#C93B3B'>cross-entropy loss</text><text x='195' y='62' fill='#6B645E'>→</text><rect x='215' y='42' width='260' height='30' rx='5' fill='#E8F5EE' stroke='#2D8B55' stroke-width='2'/><text x='345' y='62' fill='#1a5c38'>backprop + update, loop (M3)</text></g></svg>",
  note:"<b>Learn from mistakes.</b> Compare the prediction to the true digit with cross-entropy (M3 Day 1), backprop the gradient (M3 Day 2), update the weights (M3 Day 3), and repeat over all the images. This is the training loop doing its job."},
 {viz:"<svg viewBox='0 0 520 120' role='img' aria-label='Test accuracy climbs across epochs on held-out data'><g font-family='monospace'><line x1='60' y1='95' x2='430' y2='95' stroke='#E5DFD6' stroke-width='1.5'/><line x1='60' y1='25' x2='60' y2='95' stroke='#E5DFD6' stroke-width='1'/><path d='M70 80 C 150 55, 260 40, 420 35' fill='none' stroke='#2D8B55' stroke-width='2.5'/><text x='245' y='112' font-size='11' fill='#6B645E' text-anchor='middle'>epochs →</text><text x='30' y='60' font-size='11' fill='#6B645E' text-anchor='middle' transform='rotate(-90 30 60)'>test acc</text><text x='440' y='40' font-size='12' fill='#1a5c38' font-family='monospace'>~96%</text></g></svg>",
  note:"<b>It reads handwriting.</b> Test accuracy on 10,000 unseen digits climbs toward ~96%. This tiny model is the same recipe as a giant LLM — represent, forward, loss, backprop, loop — only the scale changes. The train-vs-test gap is your first evaluation check."}
];
var buildWrap=document.getElementById('build'), buildSec=document.getElementById('s5');
BUILD.forEach(function(item,i){
  var step=document.createElement('div'); step.className='build-step';
  step.innerHTML='<div class="build-viz">'+item.viz+'</div><div class="build-note"><span class="build-num">'+(i+1)+'</span>'+item.note+'</div>';
  buildWrap.appendChild(step);
});
var bsteps=Array.prototype.slice.call(buildWrap.querySelectorAll('.build-step')), bseen=0;
function bUnlock(){ var g=buildSec.querySelector('.gotit'); if(g){ g.disabled=false; g.textContent='Saw the whole build — got it ✓'; } }
function seeStep(s){ if(s.classList.contains('revealed'))return; s.classList.add('revealed'); bseen++; if(bseen>=bsteps.length) bUnlock(); }
function revealVisible(){
  var vh = window.innerHeight || document.documentElement.clientHeight;
  bsteps.forEach(function(s){
    if(s.classList.contains('revealed')) return;
    // reveal any step whose top has entered (or scrolled above) the viewport — never leave it blank
    if(s.getBoundingClientRect().top < vh*0.95) seeStep(s);
  });
}
window.__revealBuild = revealVisible;   // sidebar jumps re-check so a jumped-to build is never blank
if(!bsteps.length){ bUnlock(); }
else if(RM || !('IntersectionObserver' in window)){ bsteps.forEach(seeStep); }
else {
  buildWrap.classList.add('armed');
  var bio=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ seeStep(e.target); bio.unobserve(e.target); } }); }, {threshold:0.15, rootMargin:'0px 0px -6% 0px'});
  bsteps.forEach(function(s){ bio.observe(s); });
  // robustness: reveal steps already on screen (e.g. after a sidebar jump) and on any scroll/resize
  window.addEventListener('scroll', revealVisible, {passive:true});
  window.addEventListener('resize', revealVisible);
  revealVisible();
  setTimeout(revealVisible, 700);
}

/* ===== QUIZ ===== */
var QS=[
 {q:'1. A 28×28 MNIST image, flattened, is how many numbers?',
  opts:['28','256','784','1024'],
  ans:2, fb:'Right. 28 × 28 = 784 — the flattened input vector (M1 Day 1).'},
 {q:'2. For classifying digits 0–9, how many units does the output layer have?',
  opts:['1','10','128','784'],
  ans:1, fb:'Right. 10 outputs — one score per digit. The highest score is the prediction.'},
 {q:'3. Which loss is used to train the digit classifier?',
  opts:['MSE','cross-entropy','no loss','the dot product'],
  ans:1, fb:'Right. Classification uses cross-entropy on the softmax probabilities (M3 Day 1, M4 Day 3).'},
 {q:'4. Your MLP reports 99% test accuracy, but when a friend hands it fresh digits they drew, it gets barely 80% right. The code runs with no errors. Where do you look first?',
  opts:['add more hidden units so it can score higher','check the train/test split — likely the test set leaked into training (e.g. pixel scaling computed over all data, or the same images in both sets), which inflates the reported number','lower the learning rate','train for more epochs'],
  ans:1, fb:'Right. A big gap between reported test accuracy and true unseen performance is the signature of leakage: the model already saw the test data. Do the split first, then compute any scaling/normalization on the training set only and apply it to the test set. More units or epochs would only make the memorization worse.'}
];
var quizWrap=document.getElementById('quiz'), quizSec=document.getElementById('s6'), answered={};
QS.forEach(function(item,qi){
  var block=document.createElement('div'); block.className='q';
  var ask=document.createElement('div'); ask.className='q-ask'; ask.innerHTML=item.q; block.appendChild(ask);
  var opts=document.createElement('div'); opts.className='q-opts';
  var fb=document.createElement('div'); fb.className='q-fb';
  item.opts.forEach(function(text,oi){
    var o=document.createElement('button'); o.type='button'; o.className='q-opt';
    o.innerHTML='<span class="mark"></span><span>'+text+'</span>';
    o.addEventListener('click', function(){
      if(answered[qi]) return; answered[qi]=true;
      Array.prototype.slice.call(opts.children).forEach(function(c){c.classList.add('locked')});
      if(oi===item.ans){ o.classList.add('correct'); fb.className='q-fb good show'; fb.innerHTML='✓ '+item.fb; }
      else { o.classList.add('wrong'); opts.children[item.ans].classList.add('correct'); fb.className='q-fb bad show'; fb.innerHTML='The correct answer is the green one. '+item.fb; }
      if(Object.keys(answered).length>=QS.length){ var g=quizSec.querySelector('.gotit'); g.disabled=false; g.textContent='All four answered — check ✓'; }
    });
    opts.appendChild(o);
  });
  block.appendChild(opts); block.appendChild(fb); quizWrap.appendChild(block);
});

/* ===== COPY ===== */
Array.prototype.slice.call(document.querySelectorAll('.copy')).forEach(function(btn){
  btn.addEventListener('click', function(){
    var t=document.querySelector(btn.getAttribute('data-copy')), txt=t?t.textContent.trim():'';
    var done=function(ok){ var o=btn.textContent; btn.textContent=ok?'✓ copied':'select & copy manually'; btn.classList.toggle('done',ok); setTimeout(function(){btn.textContent=o;btn.classList.remove('done')},1600); };
    if(navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(txt).then(function(){done(true)},function(){legacy(txt,done)});
    else legacy(txt,done);
  });
});
function legacy(txt,cb){ try{ var ta=document.createElement('textarea'); ta.value=txt; ta.style.position='fixed'; ta.style.top='-1000px'; document.body.appendChild(ta); ta.select(); var ok=document.execCommand('copy'); document.body.removeChild(ta); cb(ok); }catch(e){ cb(false); } }

refresh();
})();
</script>

<!-- ── glossary tooltips ── -->
<script>
(function(){
  "use strict";
  var terms = document.querySelectorAll('.term[data-tip]');
  if(!terms.length) return;
  var tip = document.createElement('div');
  tip.id = 'term-tip'; tip.setAttribute('role','tooltip');
  document.body.appendChild(tip);
  var active = null;
  function position(el){
    var r = el.getBoundingClientRect();
    tip.style.left = '0px'; tip.style.top = '0px';
    var t = tip.getBoundingClientRect(), pad = 8;
    var left = r.left + r.width/2 - t.width/2;
    left = Math.max(pad, Math.min(left, window.innerWidth - t.width - pad));
    var top = r.top - t.height - pad;
    if(top < pad) top = r.bottom + pad;
    tip.style.left = Math.round(left)+'px';
    tip.style.top  = Math.round(top)+'px';
  }
  function show(el){
    active = el; tip.textContent = '';
    var ttl = document.createElement('span'); ttl.className = 'ttl';
    ttl.textContent = (el.textContent||'').replace(/[.:,;]+$/,'').trim();
    var body = document.createElement('span'); body.textContent = el.getAttribute('data-tip');
    tip.appendChild(ttl); tip.appendChild(body); tip.classList.add('show'); position(el);
  }
  function hide(){ active = null; tip.classList.remove('show'); }
  Array.prototype.forEach.call(terms, function(el){
    if(!el.hasAttribute('tabindex')) el.setAttribute('tabindex','0');
    el.addEventListener('mouseenter', function(){ show(el); });
    el.addEventListener('mouseleave', hide);
    el.addEventListener('focus', function(){ show(el); });
    el.addEventListener('blur', hide);
  });
  window.addEventListener('scroll', function(){ if(active) position(active); }, {passive:true});
  window.addEventListener('resize', function(){ if(active) position(active); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') hide(); });
})();
</script>

<!-- ── viz iframe: auto-size to content + manual reload safety net ──
     Root cause of the earlier "blank box" was Safari treating each local file://
     path as its own origin, so an iframe embedded from a *different* file gets its
     paint suppressed as a privacy measure — confirmed by: it worked standalone,
     it worked in Chrome, and it worked over http://localhost. Not a code bug, and
     it does not affect the deployed (https) site. Auto-resize restored; the reload
     button stays as a harmless safety net regardless of browser. -->
<script>
(function(){
  window.addEventListener('message', function(e){
    var d = e.data;
    if (!d || d.type !== 'viz-height' || typeof d.px !== 'number') return;
    var frames = document.querySelectorAll('.build-embed iframe');
    for (var i = 0; i < frames.length; i++){
      if (frames[i].contentWindow === e.source){
        frames[i].style.height = Math.min(Math.max(d.px, 320), 3200) + 'px';
        break;
      }
    }
  });
  var btn = document.getElementById('bcastReload');
  if(btn) btn.addEventListener('click', function(){
    var f = document.getElementById('bcastFrame');
    if(f) f.src = f.src;
  });
})();
</script>
</body>
</html>
